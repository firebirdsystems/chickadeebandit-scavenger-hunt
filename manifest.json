{
  "id": "scavenger-hunt",
  "contexts": ["household", "shared_space"],
  "name": "Scavenger Hunt",
  "version": "1.0.0",
  "description": "Set a list of things to find, everyone hunts and submits photo proof in secret, then the big reveal — see everyone's finds at once and award points.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "games",
  "tags": ["scavenger", "hunt", "photos", "game", "family", "party"],
  "icon": "🔎",
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "row_policies": {
    "hunts": {
      "kind": "owner_or_visibility",
      "member_column": "created_by",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "write_owner_only": true,
      "retain_days": {
        "default": 365,
        "timestamp_column": "created_at",
        "override_key": "hunt_history",
        "dependent_tables": [
          { "table": "tasks", "foreign_key": "hunt_id" },
          { "table": "submissions", "foreign_key": "hunt_id", "file_id_column": "photo_file_id" },
          { "table": "awards", "foreign_key": "hunt_id" }
        ]
      }
    },
    "tasks": {
      "kind": "inherit_visibility",
      "fk_column": "hunt_id",
      "parent_table": "hunts",
      "writer_column": "created_by",
      "insert_only_by_parent_column_member": "created_by"
    },
    "submissions": {
      "kind": "sealed_until",
      "fk_column": "hunt_id",
      "parent_table": "hunts",
      "writer_column": "member_id",
      "parent_status_column": "status",
      "visible_parent_status_values": ["closed"],
      "max_per_member": {
        "member_column": "member_id",
        "scope_columns": ["task_id"],
        "limit": 1
      },
      "frozen_when": {
        "status_column": "status",
        "locked_values": ["closed"]
      }
    },
    "awards": {
      "kind": "inherit_visibility",
      "fk_column": "hunt_id",
      "parent_table": "hunts",
      "writer_column": "awarded_by",
      "insert_only_by_parent_column_member": "created_by"
    }
  },
  "delete_cascades": {
    "hunts": [
      { "table": "tasks", "foreign_key": "hunt_id" },
      { "table": "submissions", "foreign_key": "hunt_id", "file_id_column": "photo_file_id" },
      { "table": "awards", "foreign_key": "hunt_id" }
    ],
    "tasks": [
      { "table": "submissions", "foreign_key": "task_id", "file_id_column": "photo_file_id" }
    ]
  },
  "member_references": {
    "hunts": { "column": "created_by", "on_removed": "keep" },
    "tasks": { "column": "created_by", "on_removed": "keep" },
    "submissions": { "column": "member_id", "on_removed": "delete", "file_id_column": "photo_file_id" },
    "awards": { "column": "awarded_by", "on_removed": "keep" }
  },
  "nav": { "label": "Hunt" },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT COUNT(*) AS n FROM app_scavenger_hunt__hunts h LEFT JOIN app_scavenger_hunt__submissions s ON s.hunt_id = h.id WHERE h.status = 'open' AND s.id IS NULL LIMIT 1"
    },
    "display": {
      "template": "badge",
      "count": "n",
      "label": "hunts waiting for you",
      "severity": "info"
    }
  },
  "publishes": ["hunt.opened", "hunt.closed"],
  "publish_acls": {
    "hunt.opened": { "require_role": "member" },
    "hunt.closed": { "require_role": "member" }
  },
  "resource_limits": {
    "max_db_bytes": 52428800
  }
}
