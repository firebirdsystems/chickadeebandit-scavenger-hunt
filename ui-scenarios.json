          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_scavenger_hunt__submissions (id, hunt_id, task_id, member_id, photo_file_id, caption, created_at) VALUES (?, ?, ?, ?, '', ?, datetime('now'))",
          "params": [
            "ui-s2a",
            "ui-h2",
            "ui-t3",
            "{{hunter}}",
