          "sql": "INSERT INTO app_scavenger_hunt__tasks (id, hunt_id, title, points, sort_order, created_by, created_at) VALUES (?, ?, ?, 2, 1, ?, datetime('now'))",
          "params": [
            "ui-t4",
            "ui-h2",
