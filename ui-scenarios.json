{
  "scenarios": [
    {
      "name": "an open hunt shows a member only their own sealed find, and ending it reveals the rest",
      "members": {
        "organizer": "admin",
        "hunter": "adult"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_scavenger_hunt__hunts (id, title, status, visibility, created_by, created_at) VALUES (?, ?, 'open', 'everyone', ?, datetime('now'))",
          "params": [
            "ui-h1",
            "Backyard Safari",
            "{{organizer}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_scavenger_hunt__tasks (id, hunt_id, title, points, sort_order, created_by, created_at) VALUES (?, ?, ?, 3, 0, ?, datetime('now'))",
          "params": [
            "ui-t1",
            "ui-h1",
            "Something older than the house",
            "{{organizer}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_scavenger_hunt__tasks (id, hunt_id, title, points, sort_order, created_by, created_at) VALUES (?, ?, ?, 1, 1, ?, datetime('now'))",
          "params": [
            "ui-t2",
            "ui-h1",
            "Something perfectly round",
            "{{organizer}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_scavenger_hunt__submissions (id, hunt_id, task_id, member_id, photo_file_id, caption, created_at) VALUES (?, ?, ?, ?, '', ?, datetime('now'))",
          "params": [
            "ui-s1a",
            "ui-h1",
            "ui-t1",
            "{{organizer}}",
            "The stone step by the gate"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_scavenger_hunt__submissions (id, hunt_id, task_id, member_id, photo_file_id, caption, created_at) VALUES (?, ?, ?, ?, '', ?, datetime('now'))",
          "params": [
            "ui-s1b",
            "ui-h1",
            "ui-t1",
            "{{hunter}}",
            "Grandpa's pocket knife"
          ]
        },
        {
          "action": "open",
          "as": "hunter"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"hunt-card\"][data-hunt-id=\"ui-h1\"]",
          "as": "hunter"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"hunt-card\"][data-hunt-id=\"ui-h1\"]",
          "as": "hunter"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"task-card\"][data-task-id=\"ui-t1\"]",
          "as": "hunter"
        },
        {
          "action": "expectVisible",
          "selector": "[data-testid=\"task-card\"][data-task-id=\"ui-t1\"][data-mine=\"yes\"]",
          "as": "hunter"
        },
        {
          "action": "expectCount",
          "selector": "[data-testid=\"find\"]",
          "count": 0,
          "as": "hunter"
        },
        {
          "action": "expectVisible",
          "selector": "[data-testid=\"task-card\"][data-task-id=\"ui-t1\"] [data-testid=\"task-sealed\"]",
          "as": "hunter"
        },
        {
          "action": "seedRaw",
          "sql": "UPDATE app_scavenger_hunt__hunts SET status = 'closed' WHERE id = ?",
          "params": [
            "ui-h1"
          ]
        },
        {
          "action": "reload",
          "as": "hunter"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"hunt-card\"][data-hunt-id=\"ui-h1\"]",
          "as": "hunter"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"hunt-card\"][data-hunt-id=\"ui-h1\"]",
          "as": "hunter"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"task-card\"][data-task-id=\"ui-t1\"]",
          "as": "hunter"
        },
        {
          "action": "expectCount",
          "selector": "[data-testid=\"find\"]",
          "count": 2,
          "as": "hunter"
        },
        {
          "action": "expectCount",
          "selector": "[data-testid=\"find\"][data-mine=\"no\"]",
          "count": 1,
          "as": "hunter"
        },
        {
          "action": "expectText",
          "selector": "[data-testid=\"task-card\"][data-task-id=\"ui-t1\"]",
          "text": "The stone step by the gate",
          "as": "hunter"
        }
      ]
    },
    {
