        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_scavenger_hunt__awards (id, hunt_id, submission_id, points_awarded, awarded_by, created_at) VALUES (?, ?, ?, 5, ?, datetime('now'))",
          "params": [
            "ui-w1",
            "ui-h2",
            "ui-s2a",
            "{{organizer}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_scavenger_hunt__hunts (id, title, status, visibility, created_by, created_at) VALUES (?, ?, 'draft', 'everyone', ?, datetime('now'))",
          "params": [
            "ui-h3",
            "Unfinished Hunt",
            "{{organizer}}"
          ]
        },
        {
          "action": "open",
          "as": "hunter"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"hunt-card\"][data-hunt-id=\"ui-h2\"]",
          "as": "hunter"
        },
        {
          "action": "expectCount",
          "selector": "[data-testid=\"hunt-card\"][data-hunt-id=\"ui-h3\"]",
          "count": 0,
          "as": "hunter"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"hunt-card\"][data-hunt-id=\"ui-h2\"]",
          "as": "hunter"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"task-card\"][data-task-id=\"ui-t3\"]",
          "as": "hunter"
        },
        {
          "action": "expectVisible",
          "selector": "[data-testid=\"score-row\"][data-points=\"5\"]",
          "as": "hunter"
        },
        {
          "action": "expectCount",
          "selector": "[data-testid=\"award-btn\"]",
          "count": 0,
          "as": "hunter"
        },
        {
          "action": "expectCount",
          "selector": "[data-testid=\"find\"]",
          "count": 3,
          "as": "hunter"
        },
        {
          "action": "expectCount",
          "selector": "[data-testid=\"score-row\"]",
          "count": 1,
          "as": "hunter"
        }
      ]
    }
  ]
}
